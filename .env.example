# ============================================================
# LLM PROVIDER — Change to "openai" after Groq testing is done
# ============================================================
LLM_PROVIDER=groq

# ── API Keys ──────────────────────────────────────────────
# Groq: used as LLM when LLM_PROVIDER=groq (free tier)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI: used ONLY as LLM when LLM_PROVIDER=openai (gpt-4o-mini)
#         NOT used for embeddings — embeddings are free via HuggingFace
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone: vector database
PINECONE_API_KEY=your_pinecone_api_key_here

# ── Pinecone Settings ─────────────────────────────────────
# IMPORTANT: index must be created with dimension=384 (HuggingFace all-MiniLM-L6-v2)
PINECONE_INDEX_NAME=enterprise-rag
